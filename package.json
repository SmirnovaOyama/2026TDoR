{
  "name": "2026-tdor",
  "private": true,
  "version": "1.0.0",
  "description": "A vigil page for Transgender Day of Remembrance, 20 November 2026",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "data": "node scripts/fetch-tmm.ts",
    "grid": "node scripts/build-grid.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.2",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.164.0"
  }
}
